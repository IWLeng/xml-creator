#!/bin/sh
# Blocks `git push` if any tracked Python file has a parse error.
# Enable once per clone with:  git config core.hooksPath .githooks
# Bypass in an emergency with: git push --no-verify

repo_root="$(git rev-parse --show-toplevel)"

if command -v python >/dev/null 2>&1; then
    PY=python
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v py >/dev/null 2>&1; then
    PY=py
else
    echo "pre-push: Python not found, skipping syntax check." >&2
    exit 0
fi

if ! "$PY" "$repo_root/.github/scripts/check_python_syntax.py"; then
    echo "" >&2
    echo "pre-push: push blocked - fix the Python parse errors above (or use --no-verify)." >&2
    exit 1
fi
